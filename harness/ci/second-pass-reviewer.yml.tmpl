# Second-pass reviewer - advisory fresh-context convergence review.
# Bootstrapped from kp-sdlc/harness on {{BOOTSTRAP_DATE}}.
#
# Advisory independent review: a separate Claude session sees the PR handoff,
# diff, and trusted base-SHA review policies. No prior chat history. The output
# can find candidates but cannot approve or merge a PR.
#
# Required secret: ANTHROPIC_API_KEY (workflow auto-skips if absent).
# Cost: ~$0.05–0.20 per PR depending on diff size.
name: second-pass-reviewer

on:
  pull_request_target:
    branches: [main]
    types: [opened, synchronize, reopened, ready_for_review]

permissions:
  contents: read
  pull-requests: write

concurrency:
  group: second-pass-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  review:
    name: Fresh-context convergence review
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          # pull_request_target runs the base workflow. Keep the checkout on
          # that trusted base; the PR head is fetched only as Git object data.
          ref: ${{ github.event.pull_request.base.sha }}
          fetch-depth: 0

      - name: Fetch untrusted PR head as data
        env:
          PR_NUMBER: ${{ github.event.pull_request.number }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: |
          git fetch --no-tags origin \
            "+refs/pull/$PR_NUMBER/head:refs/remotes/pull/$PR_NUMBER/head"
          git cat-file -e "$HEAD_SHA^{commit}"

      - name: Set up Python 3.12
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Check for ANTHROPIC_API_KEY
        id: keycheck
        env:
          HAS_KEY: ${{ secrets.ANTHROPIC_API_KEY != '' }}
        run: echo "has_key=$HAS_KEY" >> "$GITHUB_OUTPUT"

      - name: Run second-pass reviewer
        if: steps.keycheck.outputs.has_key == 'true'
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: |
          python .harness/hooks/second_pass_reviewer.py \
            --base "${{ github.event.pull_request.base.sha }}" \
            --head "${{ github.event.pull_request.head.sha }}" \
            --principles .claude/skills/design-philosophy/SKILL.md \
            --review-contract .claude/skills/review-convergence/SKILL.md \
            --event "$GITHUB_EVENT_PATH" \
            > review.md
          echo "review_exists=true" >> "$GITHUB_ENV"

      - name: Post review as PR comment
        if: env.review_exists == 'true'
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const review = fs.readFileSync('review.md', 'utf8');
            const body = [
              '## Second-pass review',
              '',
              '_Advisory fresh-context review using base-SHA policy, the PR handoff, and the immutable diff. This output is evidence, not merge approval._',
              '',
              review,
              '',
              '_If this review contradicts the author\'s Self-review attestation, flag it for human inspection._'
            ].join('\n');
            github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
              body
            });

      - name: Skip notice
        if: steps.keycheck.outputs.has_key != 'true'
        run: |
          echo "ANTHROPIC_API_KEY not set in repo secrets — skipping second-pass review."
          echo "Add it via: Settings → Secrets and variables → Actions → New repository secret."
